{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "types": ["@cloudflare/vitest-plugin/types"],
    "paths": { "@/*": ["../src/*"] }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "worker-env.d.ts", "vitest.config.ts"]
}
