{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["src/components/ui/**", "vendor/braces/**"],
  "workspaces": {
    ".": { "entry": ["tests/**/*.test.{ts,tsx,mjs}", "scripts/**/*.mjs", "tests/e2e/**/*.spec.ts"] },
    "worker": { "entry": ["tests/**/*.test.ts", "tests/fixtures/*entry.ts", "scripts/**/*.mjs"], "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.mjs"], "ignoreDependencies": ["cloudflare"] }
  },
  "ignoreExportsUsedInFile": true
}
